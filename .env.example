# Public URL of the site (used for SEO metadata, sitemap and e-mail links)
NEXT_PUBLIC_SITE_URL=https://learningimpact.pk

# Admin panel (/admin). Choose a long password. SESSION_SECRET signs the login cookie:
# generate one with `openssl rand -hex 32`.
ADMIN_PASSWORD=
SESSION_SECRET=

# Storage on a normal server / cPanel: a folder outside the app where data is kept (default: ./.data).
DATA_DIR=

# Storage on serverless hosting (Vercel): Supabase. Run supabase/schema.sql once in the SQL editor.
# When these are set they take priority over DATA_DIR.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: e-mail the team whenever a new request arrives (https://resend.com).
RESEND_API_KEY=
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_FROM=Learning Impact <requests@learningimpact.pk>

# Learner portal e-mails (welcome, password reset, payment confirmations, company invitations).
# Use a mailbox you created in the hosting panel, e.g. info@learningimpact.pk. Without these, the site
# still works: admins can create password-reset links and companies can copy invitation links.
SMTP_HOST=mail.learningimpact.pk
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Learning Impact <info@learningimpact.pk>
